---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>McSheffrey Musings</title>
  <link href="https://niallmcsheffrey.com/feed.xml" rel="self"/>
  <link href="https://niallmcsheffrey.com/"/>
  <id>https://niallmcsheffrey.com/</id>
  <updated>{% if collections.posts.length %}{{ collections.posts[0].date.toISOString() }}{% endif %}</updated>
  <author><name>Niall McSheffrey</name></author>
  {%- for p in collections.posts %}
  <entry>
    <title>{{ p.data.title }}</title>
    <link href="https://niallmcsheffrey.com{{ p.url }}"/>
    <id>https://niallmcsheffrey.com{{ p.url }}</id>
    <updated>{{ p.date.toISOString() }}</updated>
    <content type="html">{{ p.content | escape }}</content>
  </entry>
  {%- endfor %}
</feed>
